{
  "name": "biolume",
  "productName": "Biolume",
  "version": "0.1.0",
  "description": "Pokémon shiny hunting & encounter utility — counter, odds engine and target analyzer.",
  "private": true,
  "author": "Biolume",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:build": "node scripts/build-local-data.mjs",
    "data:za": "node scripts/build-za-data.mjs",
    "data:bdsp": "node scripts/build-bdsp-data.mjs",
    "data:pla": "node scripts/build-pla-data.mjs",
    "data:sv": "node scripts/build-sv-data.mjs",
    "data:locations": "node scripts/build-location-index.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "smoke": "electron-vite build && electron . --smoke",
    "streamdeck:build": "node streamdeck/scripts/pack.mjs --build-only",
    "streamdeck:test": "npm --prefix streamdeck test",
    "streamdeck:pack": "node streamdeck/scripts/pack.mjs",
    "dist": "npm run streamdeck:pack && npm run build && electron-builder --win"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "idb-keyval": "^6.3.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.56.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  }
}
