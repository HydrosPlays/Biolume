{
  "name": "biolume-streamdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Biolume's Elgato Stream Deck plugin (app.biolume.streamdeck).",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart app.biolume.streamdeck\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "validate": "streamdeck validate app.biolume.streamdeck.sdPlugin --no-update-check",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "rollup": "^4.64.7",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
