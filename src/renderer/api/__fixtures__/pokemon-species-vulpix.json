      }
    },
    {
      "flavor_text": "Il envoie des boules de feu. Avec\nl’âge, ses six queues en forment de\nnouvelles.",
      "language": {
        "name": "fr",
        "url": "https://pokeapi.co/api/v2/language/5/"
      },
      "version": {
        "name": "black",
        "url": "https://pokeapi.co/api/v2/version/17/"
      }
    },
    {
      "flavor_text": "As each tail grows, its fur becomes more lustrous.\nWhen held, it feels slightly warm.",
      "language": {
        "name": "en",
